{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Bash(git push integration)",
      "Bash(git push integration *)",
      "Bash(git push origin integration)",
      "Bash(git push origin integration *)",
      "Bash(git push * integration)",
      "Bash(git push * integration *)",
      "Bash(git push origin *:integration)",
      "Bash(git push origin *:integration *)",
      "Bash(git push * *:integration)",
      "Bash(git push * *:integration *)"
    ]
  }
}
